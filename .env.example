# tokentax — model selection is config-only (local <-> cloud is a pure env change).
# The API key is read ONLY from the environment, never from code or args.

# Local Ollama (default)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Ollama Cloud (set OLLAMA_API_KEY to switch; base url is https://ollama.com/api, Bearer auth)
# OLLAMA_HOST=https://ollama.com/api
# OLLAMA_MODEL=qwen3.5:122b
# OLLAMA_API_KEY=__set_in_real_env_only__

# Verify the exact tag exists in the registry before use. Real Qwen sizes: 9b / 27b / 35b / 122b.
# Tool-calling for RLM needs Ollama >= v0.17.6.
